# --- Python bytecode / caches ---
__pycache__/
*.py[cod]

# --- Virtual environment ---
.venv/
venv/

# --- Secrets & local config ---
.env
.env.*
!.env.example

# --- Test & tool caches ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Build artifacts ---
build/
dist/
*.egg-info/

# --- Datasets (Kaggle creditcard.csv is ~150 MB and licensed; never commit) ---
data/raw/*
data/processed/*
data/generated/
!data/**/.gitkeep
*.csv
*.parquet

# --- ML models (reproducible from training scripts, often large) ---
models/*
!models/.gitkeep

# --- Jupyter ---
.ipynb_checkpoints/

# --- Editor / OS noise ---
.vscode/
.idea/
Thumbs.db
desktop.ini